+#ifdef HAS_STOP_EPX_ON_NAK
+/* VT2350: a bulk IN only ever starts in the middle of a frame. If EPX has a bulk IN going when the controller polls an
+   interrupt endpoint at the start of a frame, it ends the IN as a success with no data and no token sent: 994 a second with
+   a 1 ms keyboard or mouse behind the hub. Each of those uses up a data toggle that the device never saw, so its next packet
+   is refused as DATA_SEQ about half the time. Stopping on the first NAK and starting again at SOF is not enough, as that
+   meets the polls head on, and neither is a window for the retries alone: data that is flowing re-arms at any moment. So
+   every start of a bulk IN goes through epx_in_start, an IN armed outside the window waits for it, and an IN that gets a NAK
+   stops and waits for the next frame's: one IN a frame while the device has nothing to say. */
+#define EPX_IN_FROM_US  200 // after SOF: the frame's interrupt polls are over by then
+#define EPX_IN_UNTIL_US 800 // a 64-byte packet is over before the next SOF
+static volatile bool     epx_in_waiting;
+static volatile bool     epx_sof_always; // once there has been a bulk IN, SOF stays on: it is the clock for the window
+static volatile uint32_t epx_sof_us;
+static int               epx_alarm = -1;
+
+TU_ATTR_ALWAYS_INLINE static inline bool epx_is_bulk_in(const hw_endpoint_t *ep) {
+  return ep->transfer_type == TUSB_XFER_BULK && tu_edpt_dir(ep->ep_addr) == TUSB_DIR_IN;
+}
+
+static void __tusb_irq_path_func(epx_in_start)(const hw_endpoint_t *ep) {
+  const uint32_t off = time_us_32() - epx_sof_us;
+  epx_in_waiting = false;
+  epx_sof_always = true;
+  usb_hw_set->nak_poll = USB_NAK_POLL_STOP_EPX_ON_NAK_BITS;
+  usb_hw_set->inte     = USB_INTE_HOST_SOF_BITS;
+  if (off >= EPX_IN_FROM_US && off < EPX_IN_UNTIL_US) {
+    sie_start_xfer(false, true, ep->need_pre);
+    return;
+  }
+  epx_in_waiting = true; // sof_service sets the alarm, unless this frame's SOF has been and gone
+  if (off < EPX_IN_FROM_US &&
+      hardware_alarm_set_target((uint)epx_alarm, delayed_by_us(get_absolute_time(), EPX_IN_FROM_US - off))) {
+    epx_in_waiting = false; // too near to set: the window is here
+    sie_start_xfer(false, true, ep->need_pre);
+  }
+}
+#endif
 
