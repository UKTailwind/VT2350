+#ifdef HAS_STOP_EPX_ON_NAK
+// The timer's interrupt, at the USB interrupt's priority, so neither interrupts the other; rp2usb_critical keeps thread code out
+static void epx_in_reissue(uint alarm) {
+  (void)alarm;
+  if (!epx_in_waiting) {
+    return;
+  }
+  epx_in_waiting = false;
+  if (epx->state == EPSTATE_ACTIVE && epx_is_bulk_in(epx)) {
+    hw_endpoint_t *next_ep = epx_next_pending(epx);
+    if (next_ep != NULL) {
+      sie_stop_xfer();
+      epx_save_context(epx);
+      epx_switch_ep(next_ep);
+    } else {
+      epx_in_start(epx);
+    }
+  }
+}
+#endif
